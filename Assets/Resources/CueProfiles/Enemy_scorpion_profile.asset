  - sfxId: ScorpionPoisonHiss
    audioClip: {fileID: 8300000, guid: 2cbe8c63103a7ca4586385471b27712c, type: 3}
    volume: 0.5
    pitch: 0.8
    is3D: 0
    maxDistance: 50
    priority: 40
    cooldown: 0
    note: "독 쉬익 소리 (낮은 톤)"
  - sfxId: ScorpionHitSound
    audioClip: {fileID: 8300000, guid: 2cbe8c63103a7ca4586385471b27712c, type: 3}
    volume: 0.6
    pitch: 1
    is3D: 0
    maxDistance: 50
    priority: 50
    cooldown: 0
    note: "전갈 피격음"
  - sfxId: ScorpionDeathSound
    audioClip: {fileID: 8300000, guid: 2cbe8c63103a7ca4586385471b27712c, type: 3}
