    pitch: 0.7
    is3D: 0
    maxDistance: 50
    priority: 70
    cooldown: 0
    note: "전갈 사망음 (낮은 톤)"
  entries:
  - eventKey: attack.melee.hit
    vfxIds:
    - ScorpionStingHit
    - ScorpionPoisonCloud
    sfxIds:
    - ScorpionAttackSound
    - ScorpionPoisonHiss
    priority: 2
    cameraShakePreset: Medium
    timeStopMs: 40
    note: "전갈 일반 독침 공격 (독 이펙트 포함)"
  - eventKey: attack.melee.crit
    vfxIds:
    - ScorpionStingCrit
    - ScorpionPoisonCloud
    sfxIds:
    - ScorpionCriticalSound
    - ScorpionPoisonHiss
    priority: 3
    cameraShakePreset: Heavy
    timeStopMs: 80
    note: "전갈 크리티컬 독침 공격 (강화된 독 이펙트)"
  - eventKey: enemy.hit
    vfxIds:
    - ScorpionHitEffect
    sfxIds:
    - ScorpionHitSound
    priority: 2
    cameraShakePreset: 
