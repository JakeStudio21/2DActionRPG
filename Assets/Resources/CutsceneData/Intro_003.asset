    speakerName: "\uCE5C\uC704\uB300\uC7A5"
    dialogueText: "\"\uBCF8\uB2A5\uC801\uC73C\uB85C '\uCCA0'\uC744 \uC57D\uD0C8\uD558\uACE0
      \uC788\uC5B4! \uC774 \uAE30\uC774\uD55C \uC5B4\uB460\uC758 \uC190\uAE38\uC774
      \uBC8C\uC368 \uC655\uAD6D \uD131\uBC11\uAE4C\uC9C0 \uB4E4\uC774\uB2E5\uCCE4\uB2E4\uB294
      \uC99D\uAC70\uB2E4. \uB354 \uC774\uC0C1 \uC9C0\uCCB4\uD560 \uC2DC\uAC04\uC774
      \uC5C6\uB2E4.\""
