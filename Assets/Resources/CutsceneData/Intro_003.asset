    speakerName: "\uCE5C\uC704\uB300\uC7A5"
    dialogueText: "\"\uADF8\uB798. \uB9DE\uC544. \uCD5C\uADFC \uB4E4\uC5B4\uC628
      \uC2E0\uC785\uC774 \uC0C1\uB2F9\uD788 \uC720\uB2A5\uD558\uB2E4\uACE0 \uC18C\uBB38\uC774
      \uC790\uC790\uD558\uB358\uB370..\""
    typingSpeed: 15
