    speakerName: "\uCE5C\uC704\uB300\uC7A5"
    dialogueText: "\"\uC655\uAD6D \uACF3\uACF3\uC5D0 \uD37C\uC9C4 \uC774 \uAE30\uC774\uD55C
      \uD604\uC0C1\uC758 \uC6D0\uC778\uC744 \uB0B1\uB0B1\uC774 \uD30C\uD5E4\uCE58\uACE0,
      \uC6B0\uB9AC\uAC00 \uC783\uC5B4\uBC84\uB9B0 '\uD3C9\uD654'\uB97C \uBC18\uB4DC\uC2DC
      \uB418\uCC3E\uC544 \uC624\uB3C4\uB85D! \uB124 \uAC80 \uB05D\uC5D0 \uAC08\uB77C\uB4DC\uC655\uAD6D\uC758
      \uC6B4\uBA85\uC774 \uB2EC\uB824\uC788\uC74C\uC744 \uBA85\uC2EC\uD574\uB77C.
      \uC774\uC0C1!\""
