    speakerName: "\uCE5C\uC704\uB300\uC7A5"
    dialogueText: "\"\uADF8\uB798, \uC790\uB124\uAC00 \uBC14\uB85C \uADF8 \uC18C\uBB38\uC758
      \uC2E0\uC785\uC778\uAC00? \uAC00\uC7A5 \uC911\uC694\uD55C \uC784\uBB34\uB97C
      \uB9E1\uAE38 \uB9CC\uD55C \uC7AC\uBAA9\uC778\uC9C0, \uB0B4 \uB208\uC73C\uB85C
      \uC9C1\uC811 \uD655\uC778\uD574\uC57C\uACA0\uAD70.\""
    typingSpeed: 15
    sfxEventKey: 
