    speakerName: "\uCE5C\uC704\uB300\uC7A5"
    dialogueText: "\"\uC0C1\uD669\uC774 \uC2EC\uC0C1\uCE58 \uC54A\uC544. \uC774\uBC88
      \uC870\uC0AC\uB294 \uB2E8\uC21C\uD788 \uCE7C\uC744 \uC798 \uD718\uB450\uB978\uB2E4\uACE0
      \uD574\uACB0\uB420 \uBB38\uC81C\uAC00 \uC544\uB2C8\uC57C. \uD3D0\uD558\uC758
      \uC5C4\uBA85\uC744 \uC218\uD589\uD558\uB824\uBA74, \uB0C9\uCCA0\uD55C \uD310\uB2E8\uB825\uACFC
      \uBD88\uAD74\uC758 \uC758\uC9C0\uB97C \uAC00\uC9C4 \uCD5C\uC815\uC608 \uC5D8\uB9AC\uD2B8\uAC00
      \uD544\uC694\uD558\uB2E4.\""
    typingSpeed: 15
    sfxEventKey: 
    sfxDomain: 
    bgmEventKey: 
    bgmFadeTime: 1
    bgmWaitTime: 0
