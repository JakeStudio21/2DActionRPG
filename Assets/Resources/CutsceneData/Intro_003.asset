    imageScale: 0
    imageDuration: 0
    speakerName: "\uCE5C\uC704\uB300\uC7A5"
    dialogueText: "\"\uC790, \uC2E0\uC785! \uAE34\uC7A5\uC744 \uB2A6\uCD94\uC9C0
      \uB9C8\uB77C. \uC131\uBCBD \uBC16\uC740 \uC774\uBBF8 \uD63C\uB3C8 \uADF8 \uC790\uCCB4\uB2E4.
      \uC815\uB839\uC758 \uAC00\uD638\uB97C \uC783\uC740 \uC9D0\uC2B9\uB4E4\uC774
      \uC5BC\uB9C8\uB098 \uD749\uD3EC\uD558\uAC8C \uBCC0\uD588\uB294\uC9C0 \uC0C1\uC0C1\uB3C4
      \uBABB \uD560 \uAC8C\uB2E4.\""
    typingSpeed: 15
