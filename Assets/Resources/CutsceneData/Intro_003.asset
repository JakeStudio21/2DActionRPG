    speakerName: "\uCE5C\uC704\uB300\uC7A5"
    dialogueText: "\"\uC800\uAE30 \uD6C8\uB828\uC6A9 \uD5C8\uC218\uC544\uBE44\uB97C
      \uACF5\uACA9\uD558\uACE0 \uC788\uB294... \uC544\uB2C8, \uC7A0\uAE50. \uC800
      \uB140\uC11D \uBA38\uB9AC\uB97C \uBD10\uB77C. \uB0C4\uBE44 \uB69C\uAED1? \uB188\uB4E4\uC740
      \uB2E8\uC21C\uD788 \uBBF8\uCCD0 \uB0A0\uB6F0\uB294 \uAC8C \uC544\uB2C8\uAD70.\""
