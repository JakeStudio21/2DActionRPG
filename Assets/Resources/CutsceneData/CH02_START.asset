    speakerName: 
    dialogueText: "\"\uD55C\uB54C \uCC2C\uB780\uD588\uB358 \uD669\uAE08\uC758 \uBB38\uBA85\uC740
      \uB728\uAC70\uC6B4 \uCE68\uBB35 \uC18D\uC5D0 \uC7A0\uB4E4\uC5C8\uB2E4.\"\n\n\"\uD558\uC9C0\uB9CC
      \uC601\uC6D0\uD560 \uAC83 \uAC19\uB358 \uC548\uC2DD\uC740 \uBD88\uAE38\uD55C
      \uADF8\uB9BC\uC790\uC5D0 \uC758\uD574 \uBB34\uCC38\uD788 \uAE68\uC5B4\uC9C0\uACE0
      \uB9D0\uC558\uC73C\uB2C8...\"\n\n\"\uC7A0\uB4E4\uC5B4\uC57C \uD560 \uC720\uC801\uB4E4\uC740
      \uB4A4\uD2C0\uB9B0 \uCC44 \uC77C\uC5B4\uB0AC\uACE0,\"\n\n\"\uC2E0\uC131\uD55C
      \uC218\uD638\uC790\uB4E4\uC740 \uB3C4\uB9AC\uC5B4 \uB9F9\uBAA9\uC801\uC778
      \uD30C\uAD34\uC758 \uC0AC\uB3C4\uB85C \uC804\uB77D\uD574\uBC84\uB838\uB2E4.\"\n\n\"\uAC70\uC13C
      \uBAA8\uB798\uD3ED\uD48D\uC774 \uC78A\uD600\uC9C4 \uC655\uAD6D\uC758 \uBE44\uD1B5\uD55C
      \uB208\uBB3C\uC744 \uC9D1\uC5B4\uC0BC\uD0A4\uB294 \uC9C0\uAE08,\"\n\n\"\uBA54\uB9C8\uB978
      \uB300\uC9C0 \uC544\uB798 \uAC10\uCDB0\uC9C4 \uC794\uD639\uD55C \uC9C4\uC2E4\uC774
      \uC11C\uC11C\uD788 \uB208\uC744 \uB728\uACE0 \uC788\uB2E4.\""
