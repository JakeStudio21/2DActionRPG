    speakerName: "\uAD6D\uC655"
    dialogueText: "\uCE5C\uC704\uB300\uC7A5\uC774\uC5EC, \uBCF4\uC774\uC9C0 \uC54A\uB294
      \uC801\uC774 \uC6B0\uB9AC\uC758 \uC2EC\uC7A5\uC744 \uC625\uC8C4\uACE0 \uC788\uB2E4.
      \uCCA0\uC774 \uC0AC\uB77C\uC9C4 \uC790\uB9AC\uC5D0 \uB0A8\uC740 \uAC83\uC740
      \uC624\uC9C1 \uD63C\uB3C8\uBFD0\uC774\uB2C8... \uC774 \uAE30\uC774\uD55C \uC7AC\uC559\uC758
      \uBFCC\uB9AC\uB97C \uCC3E\uC544 \uC5B4\uB460\uC744 \uAC77\uC5B4\uB0B4\uB77C."
