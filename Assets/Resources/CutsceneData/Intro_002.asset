    speakerName: "\uAD6D\uC655"
    dialogueText: "\uBB34\uB108\uC838\uAC00\uB294 \uC655\uAD6D\uC758 \uC9C8\uC11C\uB97C
      \uBC14\uB85C\uC7A1\uACE0, \uC783\uC5B4\uBC84\uB9B0 \uD3C9\uD654\uB97C \uB418\uCC3E\uB294
