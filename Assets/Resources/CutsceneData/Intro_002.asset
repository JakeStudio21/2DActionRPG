    speakerName: "\uCE5C\uC704\uB300\uC7A5"
    dialogueText: "\"\uBA85\uB839\uC744 \uBC1B\uB4E4\uACA0\uC2B5\uB2C8\uB2E4, \uD3D0\uD558.
      \uC800\uC758 \uAC80\uACFC \uBA85\uC608\uB97C \uAC78\uACE0, \uBC18\uB4DC\uC2DC
