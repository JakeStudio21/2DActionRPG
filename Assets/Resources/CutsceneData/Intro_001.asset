    dialogueText: "\"\uC815\uB839\uC758 \uCD95\uBCF5\uC740 \uBC2D\uC758 \uACE1\uC2DD\uC744
      \uC601\uAE00\uAC8C \uD588\uACE0, \uB300\uC7A5\uAC04\uC758 \uBD88\uAF43\uC744
      \uAEBC\uC9C0\uC9C0 \uC54A\uAC8C \uD588\uC73C\uBA70, \uC6B0\uB9AC\uC758 \uC0B6\uC740
