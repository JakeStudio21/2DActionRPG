    speakerName: "\uB098\uB808\uC774\uC158"
    dialogueText: "\"\uD0DC\uCD08\uC758 \uC228\uACB0\uC774 \uBA38\uBB34\uB294 \uACF3,
      \uC815\uB839\uB4E4\uC758 \uC740\uCD1D\uC774 \uB300\uC9C0\uC758 \uD54F\uC904\uB9C8\uB2E4
      \uD750\uB974\uB294 \uCC2C\uC5F0\uD55C \uB099\uC6D0 [\uAC08\uB77C\uB4DC\uC655\uAD6D].
      \""
