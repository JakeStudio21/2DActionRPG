    imageScale: 0
    imageDuration: 0
    speakerName: "\uB098\uB808\uC774\uC158"
    dialogueText: "\"\uC774\uACF3\uC758 \uC0AC\uB78C\uB4E4\uC740 \uB9CC\uBB3C\uC5D0
      \uAE43\uB4E0 \uC601\uD63C\uACFC \uC18D\uC0AD\uC774\uBA70 \uACF5\uC874\uD558\uB294
      \uBC95\uC744 \uBC30\uC6E0\uACE0, \uADF8 \uAE4A\uC740 \uC720\uB300 \uC18D\uC5D0\uC11C
      \uC655\uAD6D\uC740 \uC601\uC6D0\uD788 \uC9C0\uC9C0 \uC54A\uC744 \uAC83\uB9CC
      \uAC19\uC740 \uD669\uAE08\uAE30\uB97C \uB204\uB824\uC654\uC2B5\uB2C8\uB2E4.\""
    typingSpeed: 20
